[Unit]
Description=Silicon Dopes
Wants=network-online.target
After=network-online.target

[Service]
User=dope
Group=dope
WorkingDirectory=/srv/dope
EnvironmentFile=/etc/dope.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/dope/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --no-access-log
StateDirectory=dope
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
